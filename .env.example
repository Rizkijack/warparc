# Wallet
PRIVATE_KEY=your_private_key_here

# Optional: RPC endpoints (defaults are in hardhat.config.js)
# ETH_RPC=https://rpc.ankr.com/eth
# BASE_RPC=https://mainnet.base.org
# ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
# OPTIMISM_RPC=https://mainnet.optimism.io
# RHC_RPC=https://rpc.mainnet.chain.robinhood.com

# Arc Testnet (official): https://docs.arc.io/arc/references/connect-to-arc
# Chain ID 5042002, gas token USDC, explorer https://testnet.arcscan.app
ARC_RPC=https://rpc.testnet.arc.io

# Arc Mainnet (LAUNCH-DAY Sep 16, 2026): fill ONLY from
# https://docs.arc.io/arc/references/connect-to-arc — never guess.
# ARC_MAINNET_RPC=
# ARC_MAINNET_CHAIN_ID=

# ---------------------------------------------------------------------------
# Backend (indexer + relayer + API) — semua opsional; default fail-closed.
# Referensi lengkap: backend/README.md (tabel Environment).
# ---------------------------------------------------------------------------
# BACKEND_NETWORK=testnet          # mainnet menolak boot sampai Arc mainnet diisi (2026-09-16)
# BACKEND_INDEX_CHAINS=arc         # CSV; mis. arc,baseSepolia
# BACKEND_DATA_DIR=backend/data    # events.jsonl + state.json (gitignored)
# BACKEND_HOST=127.0.0.1           # bind API — jangan expose publik
# BACKEND_PORT=8932
# BACKEND_CORS_ORIGIN=             # opsional; tanpa ini CORS nonaktif
# BACKEND_STATUS_IRIS_RPS=2        # throttle /status ke Iris (budget global 40 req/s)
# RELAYER_ENABLED=false            # master switch kirim (watch-only default)
# RELAYER_DRY_RUN=true             # false + enabled → benar-benar kirim tx
# RELAYER_PRIVATE_KEY=             # env saja; key relayer (gas), bukan key user
# RELAYER_AUTO_RELAY=false         # enqueue otomatis burn yang cocok kebijakan
# RELAYER_MAX_USDC_PER_TX=1000     # cap amount utk auto-relay
# RELAYER_DAILY_USDC_BUDGET=50     # budget gas harian Arc (USDC)
# RELAYER_DAILY_ETH_BUDGET=0.5     # budget gas harian tujuan EVM (ETH)
# RELAYER_IRIS_CHECKS_PER_TICK=20  # max cek attestation per tick (Iris 40 req/s)
# RELAYER_IRIS_TIMEOUT_MS=10000    # timeout per request ke Iris
# RELAYER_ARC_MAX_FEE_GAS_GWEI=30  # ≥ 20 Gwei floor Arc (type-2, tip 0)
# RELAYER_ALLOW_HOOKS=false        # izinkan relay burn ber-hook
# RELAYER_POLL_MS=5000             # interval tick relayer
# RELAYER_MAX_JOBS=500             # cap store job
# RELAYER_ATTESTATION_TIMEOUT_MS=600000
# RELAYER_MAX_ATTEMPTS=5           # max retry submit per job

