# ============================================================================
# WarpArc contoh environment — salin ke .env (JANGAN pernah commit .env asli).
#
# Semua default di bawah adalah nilai yang benar-benar dibaca kode:
#   hardhat.config.js, backend/src/config.js, backend/src/server.js,
#   backend/src/relayer.js, backend/src/indexer.js — bukan tebakan.
#
# Catatan pemuatan env: Hardhat memuat .env otomatis via dotenv, tetapi
# backend (`npm run backend`) membaca process.env langsung — set variabel
# backend via shell/export, mis. `BACKEND_NETWORK=testnet npm run backend`.
# ============================================================================

# ---------------------------------------------------------------------------
# Hardhat / scripts (deploy, cctp-test, mint-arc)
# ---------------------------------------------------------------------------

# Key deployer kontrak. Placeholder/dummy → Hardhat pakai throwaway key
# (compile/test saja); script deploy menolak menandatani dengannya.
# Ini BUKAN key relayer — lihat catatan keamanan di bawah.
PRIVATE_KEY=your_private_key_here

# RPC override per jaringan Hardhat (default sudah ada di hardhat.config.js)
# ETH_RPC=https://rpc.ankr.com/eth
# BASE_RPC=https://mainnet.base.org
# ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
# OPTIMISM_RPC=https://mainnet.optimism.io
# RHC_RPC=https://rpc.mainnet.chain.robinhood.com

# Arc Testnet (official): https://docs.arc.io/arc/references/connect-to-arc
# Chain ID 5042002, gas token USDC, explorer https://testnet.arcscan.app
ARC_RPC=https://rpc.testnet.arc.io

# Verified 2026-08-26: https://docs.arc.io/arc/references/contract-addresses — "Mainnet addresses are not yet available" (testnet 5042002)
# Arc Mainnet (LAUNCH-DAY Sep 16, 2026): isi HANYA dari
# https://docs.arc.io/arc/references/connect-to-arc — jangan pernah menebak.
# Keduanya harus diset untuk mengaktifkan network arcMainnet di Hardhat;
# kosong = fail closed (error saat connect).
# ARC_MAINNET_RPC=https://...
# ARC_MAINNET_CHAIN_ID=

# ---------------------------------------------------------------------------
# Backend core (indexer + API)
# ---------------------------------------------------------------------------
# RELAYER_PRIVATE_KEY=             # env saja; key relayer (gas), bukan key user
# BACKEND_AUTO_RELAY=false         # enqueue otomatis burn yang cocok kebijakan; default false = watch-only (pantau saja)
# RELAYER_MAX_USDC_PER_TX=1000     # cap amount utk auto-relay

# BACKEND_NETWORK=testnet            # atau mainnet; mainnet menolak boot sampai chains.arcMainnet diisi (2026-09-16)
# BACKEND_INDEX_CHAINS=arc           # CSV chain yang diindeks; default arc (testnet) / arcMainnet (mainnet)
# BACKEND_DATA_DIR=backend/data      # events.jsonl + state.json (gitignored)
# BACKEND_HOST=127.0.0.1             # bind API — jangan expose publik
# BACKEND_PORT=8932
# BACKEND_CORS_ORIGIN=               # opsional; tanpa ini CORS nonaktif (API same-origin/localhost saja)
# BACKEND_API_TOKEN=                 # bila diset: POST /relay wajib header "Authorization: Bearer <token>" yang cocok
# BACKEND_STATUS_IRIS_RPS=2          # throttle lookup Iris via /status & MCP agar tak makan budget global Iris 40 req/s milik relayer
# LOG_JSON=false                     # true → log terstruktur JSON ke stderr {ts,level,msg,...}, false → plain [server]/[indexer]/[relayer] ke stderr/stdout (default plain)
BACKEND_EVENTS_MAX_MB=50
# BACKEND_EVENTS_MAX_MB=50           # threshold rotasi events.jsonl → events-YYYYMMDD-NNN.jsonl (MB); default 50 (dupe commented for grep-compat)

# Internal — jarang perlu diset manual. backend/src/index.js dan harness test
# menyetel ini ke "1" supaya indexer TIDAK memasang handler SIGINT sendiri
# (proses induk yang mengelola shutdown sendiri).
# BACKEND_NO_SIGINT=

# ---------------------------------------------------------------------------
# Relayer (CCTP V2 burn→mint)
# ---------------------------------------------------------------------------
# Watch-only default: kirim tx hanya jika ENABLED=true DAN DRY_RUN=false DAN
# RELAYER_PRIVATE_KEY tersedia (tiga-tiganya sekaligus).

# RELAYER_ENABLED=false              # master switch pengiriman
# RELAYER_DRY_RUN=true               # false + enabled → benar-benar kirim tx
# RELAYER_PRIVATE_KEY=               # key dompet gas relayer via env saja (bukan key user, bukan key deployer)
# BACKEND_AUTO_RELAY=false           # watch MessageSent → enqueue otomatis burn yang cocok kebijakan
# RELAYER_ALLOW_HOOKS=false          # izinkan relay burn ber-hook (default: plain burn-and-mint saja)
# RELAYER_MAX_USDC_PER_TX=1000       # cap amount untuk auto-relay
# RELAYER_POLL_MS=5000               # interval tick relayer
# RELAYER_IRIS_CHECKS_PER_TICK=20    # max cek attestation per tick (jaga limit Iris 40 req/s)
# RELAYER_ATTESTATION_TIMEOUT_MS=600000  # batas tunggu attestation per job
# RELAYER_IRIS_TIMEOUT_MS=10000      # timeout per request HTTP ke Iris (anti freeze tick loop)
# RELAYER_ARC_MAX_FEE_GAS_GWEI=30    # maxFeePerGas tx Arc (Gwei, type-2 tip 0); < floor 20 Gwei ditolak jaringan
# RELAYER_DAILY_USDC_BUDGET=50       # budget gas harian tujuan Arc (USDC); submit pause saat terlampaui
# RELAYER_DAILY_ETH_BUDGET=0.5       # budget gas harian tujuan EVM (ETH)
# RELAYER_MAX_JOBS=500               # cap job di store (terminal terlama dipangkas)
# RELAYER_MAX_ATTEMPTS=5             # max retry submit per job
# RELAYER_MCP_SUBMIT=false           # opt-in ketat (fail-closed): izinkan tool MCP warparc_relay_submit mendorong job ke antrian submit; tanpa flag ini MCP hanya watch-only
# MCP_IRIS_TIMEOUT_MS=15000        # deadline lookup Iris di warparc_status + fetch klien Iris standalone (default 15000 dari mcp-server.js:81)
# MCP_RPC_TIMEOUT_MS=15000         # deadline validateBurnTx (lookup receipt RPC) saat submit via MCP (default 15000 dari mcp-server.js:84)

# ---------------------------------------------------------------------------
# Observability (zero-dep, minimal)
# ---------------------------------------------------------------------------
# - GET /metrics (Prometheus text/plain) — no auth, same Host guard + CORS as GET lain
# - LOG_JSON=true mengaktifkan log terstruktur (lihat di atas)

# ---------------------------------------------------------------------------
# Keamanan
# ---------------------------------------------------------------------------
# - Rahasia (PRIVATE_KEY / RELAYER_PRIVATE_KEY) tidak pernah di-log, tidak
#   ditulis ke store/events.jsonl, tidak di-echo ke respons API, tidak di-commit.
# - Default aman: testnet + watch-only. Mode kirim nyata butuh tiga hal
#   sekaligus (ENABLED=true, DRY_RUN=false, RELAYER_PRIVATE_KEY ada).
# - PRIVATE_KEY      = key deployer kontrak untuk Hardhat/scripts.
#   RELAYER_PRIVATE_KEY = key dompet gas relayer — hanya membayar gas sendiri,
#   tidak pernah memindahkan dana user. Gunakan dompet terpisah dan didanai
#   secukupnya (USDC testnet via https://faucet.circle.com; gas Arc = USDC).
